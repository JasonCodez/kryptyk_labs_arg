// ─── Puzzle Warz ─────────────────────────────────────────────────────────────

enum WarzChallengeStatus {
  OPEN          // posted, waiting for an opponent
  IN_PROGRESS   // opponent accepted, playing now
  COMPLETED     // both players finished — winner determined
  EXPIRED       // 24h passed with no opponent; wager refunded
  CANCELLED     // challenger withdrew before anyone accepted
  FORFEITED     // one player forfeited; rules: if only one forfeits, the other wins the pot
}

model PuzzleWarzChallenge {
  id               String               @id @default(cuid())
  puzzleId         String
  challengerId     String
  challengerTime   Int                  // seconds to complete
  challengerWager  Int                  // 1–500 pts; held in escrow on creation
  // Optional: challenger can invite a specific player
  invitedUserId    String?
  // Opponent fields — populated when someone accepts
  opponentId       String?
  opponentTime     Int?                 // seconds; set when opponent finishes (or DNF sentinel 999999)
  // Outcome
  status           WarzChallengeStatus  @default(OPEN)
  winnerId         String?              // null = tie/split (both forfeited)
  potPaid          Boolean              @default(false)  // guard against double-pay
  expiresAt        DateTime             // createdAt + 24h (or extended via item)
  spotlightUntil   DateTime?            // if set, pinned at top of open challenges list
  createdAt        DateTime             @default(now())
  completedAt      DateTime?
  // Relations
  puzzle           Puzzle               @relation("WarzChallenges", fields: [puzzleId], references: [id], onDelete: Cascade)
  challenger       User                 @relation("WarzChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  invitedUser      User?                @relation("WarzInvited", fields: [invitedUserId], references: [id], onDelete: SetNull)
  opponent         User?                @relation("WarzOpponent", fields: [opponentId], references: [id], onDelete: SetNull)
  winner           User?                @relation("WarzWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([challengerId])
  @@index([opponentId])
  @@index([puzzleId])
  @@index([expiresAt])
  @@map("puzzle_warz_challenges")
}

// ── Season Pass ─────────────────────────────────────────────────────────────

model Season {
  id          String   @id @default(cuid())
  name        String                           // e.g. "Season 1 — Ignition"
  description String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  premiumPrice Int     @default(500)            // Cost in points to upgrade to premium track
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tiers       SeasonTier[]
  userPasses  UserSeasonPass[]

  @@index([isActive])
  @@index([startDate, endDate])
  @@map("seasons")
}

model SeasonTier {
  id             String  @id @default(cuid())
  seasonId       String
  tierNumber     Int                             // 1-30
  xpRequired     Int                             // Cumulative XP needed to unlock this tier
  freeRewardType String?                         // null | "hint_tokens" | "points" | "skip_tokens" | "streak_shields" | "cosmetic"
  freeRewardKey  String?                         // For cosmetics: the item key. For consumables: ignored (qty used)
  freeRewardQty  Int     @default(0)             // How many to grant (e.g. 2 hint tokens)
  premRewardType String?                         // Same types as free
  premRewardKey  String?
  premRewardQty  Int     @default(0)
  season         Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, tierNumber])
  @@index([seasonId])
  @@map("season_tiers")
}

model UserSeasonPass {
  id            String   @id @default(cuid())
  userId        String
  seasonId      String
  isPremium     Boolean  @default(false)
  seasonXp      Int      @default(0)             // XP earned during this season
  currentTier   Int      @default(0)             // Highest tier reached
  claimedFree   Int[]    @default([])            // Tier numbers claimed on free track
  claimedPrem   Int[]    @default([])            // Tier numbers claimed on premium track
  purchasedAt   DateTime?                        // When they bought premium (null = free only)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([userId])
  @@index([seasonId])
  @@map("user_season_passes")
}

// ── FREQUENCY ──────────────────────────────────────────────────────────────

model FrequencyQuestion {
  id           String                @id @default(cuid())
  question     String
  scheduledFor DateTime              @db.Date
  status       String                @default("pending") // pending | revealed
  canonicalGroups Json?
  createdAt    DateTime              @default(now())
  answers      FrequencyAnswer[]
  submissions  FrequencySubmission[]

  @@unique([scheduledFor])
  @@index([status])
  @@map("frequency_questions")
}

model FrequencyAnswer {
  id          String            @id @default(cuid())
  questionId  String
  text        String            // normalized answer text
  displayText String            // original / admin-set display label
  count       Int               @default(0)
  question    FrequencyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, text])
  @@index([questionId])
  @@map("frequency_answers")
}

model FrequencySubmission {
  id         String            @id @default(cuid())
  questionId String
  userId     String?           // null = guest
  sessionId  String?           // for guests
  answers    Json              // string[] — raw answers submitted
  score      Int               @default(0)
  createdAt  DateTime          @default(now())
  question   FrequencyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([questionId, userId])
  @@index([questionId])
  @@index([userId])
  @@map("frequency_submissions")
}

// ── Witness Debrief puzzle ───────────────────────────────────────────────────

model WitnessResult {
  id         String   @id @default(cuid())
  scenarioId String
  score      Int      // 0–5
  breakdown  Json?    // [{ correct: boolean, correctIndex: number }, ...] per-question detail
  userId     String?
  createdAt  DateTime @default(now())

  @@index([scenarioId])
  @@index([userId, scenarioId])
  @@map("witness_results")
}

// ── User Safety — Block & Report ─────────────────────────────────────────────

model UserBlock {
  id          String   @id @default(cuid())
  issuerId    String
  targetId    String
  createdAt   DateTime @default(now())
  issuer      User     @relation("BlockIssuer", fields: [issuerId], references: [id], onDelete: Cascade)
  target      User     @relation("BlockTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([issuerId, targetId])
  @@index([issuerId])
  @@index([targetId])
  @@map("user_blocks")
}

model UserReport {
  id          String   @id @default(cuid())
  issuerId    String
  targetId    String
  reason      String                       // e.g. "spam", "harassment", "hate_speech", "other"
  details     String?
  status      String   @default("pending") // "pending" | "reviewed" | "dismissed"
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime @default(now())
  issuer      User     @relation("ReportIssuer", fields: [issuerId], references: [id], onDelete: Cascade)
  target      User     @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([issuerId])
  @@index([targetId])
  @@index([status])
  @@map("user_reports")
}

model BugReport {
  id            String    @id @default(cuid())
  userId        String?                        // null for anonymous reporters
  puzzleId      String?                        // null when "Other" location was chosen, or puzzle later deleted
  puzzleTitle   String?                        // snapshot at submit time — survives puzzle deletion/rename
  otherLocation String?                        // free text, only set when puzzleId is null
  description   String                         // what happened
  contactEmail  String?                        // optional, for anonymous reporters or an alternate reply-to
  status        String    @default("pending")  // "pending" | "reviewed" | "dismissed"
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime  @default(now())
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  puzzle        Puzzle?   @relation(fields: [puzzleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([puzzleId])
  @@index([status])
  @@map("bug_reports")
}
