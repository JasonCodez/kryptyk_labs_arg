# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.gradle/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/debug.log
/blob-report/

# next.js
/.next/
/out/

# dev build cache (redirected to C:\ for faster I/O)
C:/tmp/puzzlewarz-next

# production
/build
local.properties
app-release-unsigned-aligned.apk

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local helper env files
sendgrid.env

# runtime uploads (admin/media uploads, imported puzzle images, etc.)
/public/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/.mcp.json
