{
  "name": "puzzle-warz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true,maxRetries:10,retryDelay:200})\" && next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start -p $PORT",
    "lint": "eslint .",
    "lint:crossword": "eslint src/components/puzzle/CrosswordPuzzle.tsx src/components/puzzle/crossword src/components/app-shell/PuzzleHeader.tsx src/components/app-shell/PuzzleHeader.test.tsx src/components/puzzle/PuzzleBugReportButton.tsx src/app/daily/crossword/page.tsx src/components/puzzle/PuzzleTypeRenderer.tsx \"src/app/puzzles/[id]/page.tsx\" tests/e2e/mobile-shell.spec.ts tests/e2e/crossword-mobile.spec.ts",
    "lint:anagram": "eslint src/components/puzzle/AnagramBlitz.tsx src/components/puzzle/AnagramBlitz.test.tsx src/components/puzzle/anagram src/components/puzzle/PuzzleTypeRenderer.tsx src/components/app-shell/PuzzleHeader.tsx src/lib/anagramConfig.ts \"src/app/puzzles/[id]/page.tsx\" tests/e2e/anagram-mobile.spec.ts",
    "lint:sudoku": "eslint src/components/puzzle/SudokuPuzzle.tsx src/components/puzzle/SudokuGrid.tsx src/components/puzzle/SudokuPuzzle.test.tsx src/components/puzzle/sudoku src/lib/sudokuPlay.ts src/lib/puzzle-progress/sudoku-actions.ts src/lib/puzzle-progress/sudoku-attempt-validation.ts src/lib/puzzle-progress/attempt-actions.ts src/app/daily/sudoku/page.tsx \"src/app/api/puzzles/[id]/progress/route.ts\" \"src/app/api/puzzles/[id]/progress/route.test.ts\" \"src/app/api/puzzles/[id]/progress/route-get.test.ts\" \"src/app/puzzles/[id]/page.tsx\" tests/e2e/sudoku-mobile.spec.ts",
    "pwa:screenshots": "node scripts/generate-pwa-screenshots.mjs",
    "twa:init": "npx @bubblewrap/cli init --manifest=https://www.puzzlewarz.com/manifest.webmanifest",
    "twa:build": "npx @bubblewrap/cli build",
    "twa:install": "npx @bubblewrap/cli install",
    "seed": "tsx prisma/seed.ts",
    "seed:store": "tsx scripts/seed-store.ts",
    "seed:puzzles": "tsx scripts/seed-puzzles.ts",
    "seed:ghost": "tsx scripts/seed-ghost-users.ts",
    "validate:escape-room": "tsx scripts/validate-escape-room-wiring.ts",
    "test:e2e": "playwright test",
    "test:unit": "jest --runInBand",
    "test:crossword": "playwright test tests/e2e/crossword-mobile.spec.ts",
    "test:anagram": "playwright test tests/e2e/anagram-mobile.spec.ts",
    "test:sudoku": "playwright test tests/e2e/sudoku-mobile.spec.ts",
    "socket-server": "node scripts/socket-server.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^6.19.2",
    "@sendgrid/mail": "^8.1.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^7.0.4",
    "axios": "^1.13.3",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "crossword-generator": "^1.0.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "driver.js": "^1.6.0",
    "framer-motion": "^12.24.10",
    "gsap": "^3.14.2",
    "jest": "^30.2.0",
    "lucide-react": "^0.562.0",
    "mysql2": "^3.16.1",
    "next": "^16.2.2",
    "next-auth": "^4.24.13",
    "node-fetch": "^3.3.2",
    "node-vibrant": "^3.1.6",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "pixi-sound": "^3.0.4",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.14.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-p5": "^1.4.1",
    "redis": "^5.10.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.0.0",
    "tegaki": "^0.17.1",
    "the-big-username-blacklist": "^1.0.0",
    "ts-jest": "^29.4.6",
    "uuid": "^13.0.0",
    "word-list": "^4.1.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest-environment-jsdom": "^30.3.0",
    "prisma": "^6.19.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
